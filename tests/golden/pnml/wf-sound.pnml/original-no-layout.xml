<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="wf-sound" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>Sound workflow net: parallel review and credit check</text></name>
    <page id="page">
      <place id="i"><name><text>i</text></name><initialMarking><text>1</text></initialMarking></place>
      <place id="p_reg"><name><text>p_reg</text></name></place>
      <place id="p_rev0"><name><text>p_rev0</text></name></place>
      <place id="p_cred0"><name><text>p_cred0</text></name></place>
      <place id="p_rev1"><name><text>p_rev1</text></name></place>
      <place id="p_cred1"><name><text>p_cred1</text></name></place>
      <place id="p_ready"><name><text>p_ready</text></name></place>
      <place id="o"><name><text>o</text></name></place>
      <transition id="register"><name><text>register</text></name></transition>
      <transition id="split"><name><text>split</text></name></transition>
      <transition id="review"><name><text>review</text></name></transition>
      <transition id="credit"><name><text>credit</text></name></transition>
      <transition id="join"><name><text>join</text></name></transition>
      <transition id="finish"><name><text>finish</text></name></transition>
      <arc id="a1" source="i" target="register"/>
      <arc id="a2" source="register" target="p_reg"/>
      <arc id="a3" source="p_reg" target="split"/>
      <arc id="a4" source="split" target="p_rev0"/>
      <arc id="a5" source="split" target="p_cred0"/>
      <arc id="a6" source="p_rev0" target="review"/>
      <arc id="a7" source="review" target="p_rev1"/>
      <arc id="a8" source="p_cred0" target="credit"/>
      <arc id="a9" source="credit" target="p_cred1"/>
      <arc id="a10" source="p_rev1" target="join"/>
      <arc id="a11" source="p_cred1" target="join"/>
      <arc id="a12" source="join" target="p_ready"/>
      <arc id="a13" source="p_ready" target="finish"/>
      <arc id="a14" source="finish" target="o"/>
    </page>
  </net>
</pnml>
