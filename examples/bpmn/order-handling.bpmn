<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_order" targetNamespace="urn:repr-werkbank:examples">
  <bpmn:process id="Process_order" name="Order handling">
    <bpmn:startEvent id="Start" name="Order received"/>
    <bpmn:userTask id="Check" name="Check order">
      <bpmn:dataInputAssociation id="CheckIn">
        <bpmn:sourceRef>OrderRef</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Valid" name="Order valid?" default="Flow_no"/>
    <bpmn:parallelGateway id="Split"/>
    <bpmn:serviceTask id="Reserve" name="Reserve stock"/>
    <bpmn:scriptTask id="Invoice" name="Create invoice"/>
    <bpmn:parallelGateway id="Join"/>
    <bpmn:intermediateCatchEvent id="Wait" name="Wait 2 days">
      <bpmn:timerEventDefinition/>
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="Ship" name="Ship order">
      <bpmn:startEvent id="ShipStart"/>
      <bpmn:task id="Pack" name="Pack items"/>
      <bpmn:endEvent id="ShipEnd"/>
      <bpmn:sequenceFlow id="Flow_s1" sourceRef="ShipStart" targetRef="Pack"/>
      <bpmn:sequenceFlow id="Flow_s2" sourceRef="Pack" targetRef="ShipEnd"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="Done" name="Order completed"/>
    <bpmn:endEvent id="Rejected" name="Order rejected">
      <bpmn:terminateEventDefinition/>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="OrderRef" name="Order" dataObjectRef="OrderData"/>
    <bpmn:dataObject id="OrderData"/>
    <bpmn:textAnnotation id="Note">
      <bpmn:text>Orders above 1000 EUR need a manager</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="NoteLink" sourceRef="Check" targetRef="Note"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Check"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Check" targetRef="Valid"/>
    <bpmn:sequenceFlow id="Flow_yes" name="yes" sourceRef="Valid" targetRef="Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">valid == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_no" name="no" sourceRef="Valid" targetRef="Rejected"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Split" targetRef="Reserve"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Split" targetRef="Invoice"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Reserve" targetRef="Join"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Invoice" targetRef="Join"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Join" targetRef="Wait"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Wait" targetRef="Ship"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Ship" targetRef="Done"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_order">
    <bpmndi:BPMNPlane id="Plane_order" bpmnElement="Process_order">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="152" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="133" y="145" width="74" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_di" bpmnElement="Check">
        <dc:Bounds x="240" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Valid_di" bpmnElement="Valid" isMarkerVisible="true">
        <dc:Bounds x="395" y="95" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="392" y="65" width="56" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Split_di" bpmnElement="Split">
        <dc:Bounds x="505" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Reserve_di" bpmnElement="Reserve">
        <dc:Bounds x="600" y="30" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Invoice_di" bpmnElement="Invoice">
        <dc:Bounds x="600" y="150" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join">
        <dc:Bounds x="755" y="95" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Wait_di" bpmnElement="Wait">
        <dc:Bounds x="862" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ship_di" bpmnElement="Ship" isExpanded="false">
        <dc:Bounds x="950" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Done_di" bpmnElement="Done">
        <dc:Bounds x="1102" y="102" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Rejected_di" bpmnElement="Rejected">
        <dc:Bounds x="402" y="282" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderRef_di" bpmnElement="OrderRef">
        <dc:Bounds x="272" y="215" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_di" bpmnElement="Note">
        <dc:Bounds x="240" y="-10" width="160" height="40"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="NoteLink_di" bpmnElement="NoteLink">
        <di:waypoint x="290" y="80"/>
        <di:waypoint x="290" y="30"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CheckIn_di" bpmnElement="CheckIn">
        <di:waypoint x="290" y="215"/>
        <di:waypoint x="290" y="160"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120"/>
        <di:waypoint x="240" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120"/>
        <di:waypoint x="395" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_yes_di" bpmnElement="Flow_yes">
        <di:waypoint x="445" y="120"/>
        <di:waypoint x="505" y="120"/>
        <bpmndi:BPMNLabel><dc:Bounds x="466" y="102" width="18" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_no_di" bpmnElement="Flow_no">
        <di:waypoint x="420" y="145"/>
        <di:waypoint x="420" y="282"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="530" y="95"/>
        <di:waypoint x="530" y="70"/>
        <di:waypoint x="600" y="70"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="530" y="145"/>
        <di:waypoint x="530" y="190"/>
        <di:waypoint x="600" y="190"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="700" y="70"/>
        <di:waypoint x="780" y="70"/>
        <di:waypoint x="780" y="95"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="700" y="190"/>
        <di:waypoint x="780" y="190"/>
        <di:waypoint x="780" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="805" y="120"/>
        <di:waypoint x="862" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="898" y="120"/>
        <di:waypoint x="950" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1050" y="120"/>
        <di:waypoint x="1102" y="120"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
